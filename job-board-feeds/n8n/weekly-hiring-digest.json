{
  "name": "Weekly hiring digest (Company Job Board Feeds)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [1],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "4f1c2a10-0001-4a6e-9a01-000000000001",
      "name": "Every Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/reliable-apps~company-job-board-feeds/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "maxTotalChargeUsd",
              "value": "0.50"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"companies\": [\n    \"greenhouse:airbnb\",\n    \"lever:palantir\",\n    {\"provider\": \"ashby\", \"token\": \"openai\", \"name\": \"OpenAI\"}\n  ],\n  \"postedWithinDays\": 7,\n  \"maxJobsPerCompany\": 100,\n  \"includeDescription\": false\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "4f1c2a10-0002-4a6e-9a01-000000000002",
      "name": "Run Company Job Board Feeds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Apify API token (header Authorization: Bearer <your token>)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "b7d0e6a1-0003-4c1d-8f00-000000000003",
              "leftValue": "={{ $json.type }}",
              "rightValue": "job",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4f1c2a10-0003-4a6e-9a01-000000000003",
      "name": "Keep job records",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "// Group the week's new postings by company into one digest item.\n// Connect a Slack, email or Notion node after this one to deliver it.\nconst byCompany = {};\nfor (const { json: job } of $input.all()) {\n  (byCompany[job.company] ??= []).push(job);\n}\nconst lines = [];\nfor (const [company, jobs] of Object.entries(byCompany)) {\n  lines.push(`${company}: ${jobs.length} new role(s)`);\n  for (const j of jobs) {\n    const where = (j.locations || []).join(', ') || 'location not stated';\n    lines.push(`  - ${j.title} (${j.department || 'no department'}, ${where}) ${j.job_url}`);\n  }\n}\nreturn [{ json: { total: $input.all().length, companies: Object.keys(byCompany).length, digest: lines.join('\\n') } }];"
      },
      "id": "4f1c2a10-0004-4a6e-9a01-000000000004",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Every Monday 08:00": {
      "main": [[{ "node": "Run Company Job Board Feeds", "type": "main", "index": 0 }]]
    },
    "Run Company Job Board Feeds": {
      "main": [[{ "node": "Keep job records", "type": "main", "index": 0 }]]
    },
    "Keep job records": {
      "main": [[{ "node": "Build digest", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
